# Kopiraj u .env (gitignored), upiši vrijednosti i učitaj prije pokretanja:
#   set -a; source .env; set +a; ./mvnw spring-boot:run

# Obavezno — najmanje 32 bajta, npr: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Potrebno samo za uvoz restorana iz Google Places
GOOGLE_PLACES_API_KEY=CHANGE_ME

# Email-ovi (zarezom odvojeni) koji imaju ROLE_ADMIN i pristup /api/admin/**
ADMIN_EMAILS=admin@example.com

# Produkcija (HTTPS): Secure kolačić i stvarni frontend origin
JWT_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Baza — podrazumijevano odgovara compose.yaml
# DB_USERNAME=root
# DB_PASSWORD=verysecret
